# Copy this file to `.env` and fill in real values.

# Port the local server listens on
PORT=3000

# Long random string used to sign session cookies
SESSION_SECRET=please-change-me-to-a-long-random-string

# Public origin used when building the embed snippet shown to merchants
PUBLIC_BASE_URL=http://localhost:3000

# LLM provider. Any OpenAI-compatible chat-completions endpoint works
# (OpenAI, DeepSeek, Together, Groq, OpenRouter, ...).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini