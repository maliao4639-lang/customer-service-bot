# Copy this file to `.env` and fill in real values.

# Port the local server listens on
PORT=3000

# Long random string used to sign session cookies
SESSION_SECRET=please-change-me-to-a-long-random-string

# Public origin used when building the embed snippet shown to merchants
PUBLIC_BASE_URL=http://localhost:3000

# LLM provider. Any OpenAI-compatible chat-completions endpoint works
# (OpenAI, DeepSeek, Together, Groq, OpenRouter, ...).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini

# Shopify managed installation (server-side credentials; never put secrets in TOML)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Generate 32 random bytes, hex encoded (64 hex characters); keep stable across deploys
SHOPIFY_TOKEN_ENCRYPTION_KEY=
# Only true for development-store billing tests; production must be false
SHOPIFY_BILLING_TEST=false
# CLI development loads .env through npm run shopify; do not commit real values
# SHOPIFY_FLAG_STORE_PASSWORD=
# SHOPIFY_CLI_PATH=
# CLI 4.9 supplies APP_URL/HOST for its public tunnel; these win in development
# SHOPIFY_APP_URL is also accepted as a compatibility alias
# HOST is an optional alias for PUBLIC_BASE_URL; SCOPES is not used (TOML is authoritative)
# Optional persistent SQLite directory; use a dedicated temporary directory in tests
# CSB_DATA_DIR=
